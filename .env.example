# Supabase — Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon/public key. Safe to expose to the browser (Supabase RLS is the
# second layer of tenant isolation on top of this app's own tenant_id checks).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# The service_role key. NEVER expose this to the browser — server-only code
# (lib/supabase/server.ts) uses it to bypass RLS, since tenant isolation is
# enforced in application code (see ARCHITECTURE.md).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App branding, shown in page titles and the login screen.
NEXT_PUBLIC_APP_NAME=تمام
NEXT_PUBLIC_APP_NAME_EN=Tamam

# Signs/verifies session JWTs (tenant staff/student login — see
# lib/auth/session.ts). Generate a 32-byte random hex value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session.
SESSION_SECRET=

# Optional: Upstash Redis, for a rate limiter that persists across deploys
# and instances (see lib/auth/rate-limit.ts). Create a free database at
# https://console.upstash.com/redis, then copy its "REST API" URL/token.
# If left unset, login/registration falls back to an in-memory limiter
# (fine for local dev; doesn't stop a distributed attacker in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
